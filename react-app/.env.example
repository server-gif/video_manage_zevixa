# ---------------------------------------------------------------------------
# TEMPLATE - safe to commit (no secrets). Copy this file to `.env` and fill in
# real values for your environment:  cp .env.example .env
#
# Only VITE_-prefixed variables reach browser code, and they are inlined at
# BUILD time (rebuild after editing). See src/lib/config.js for the reader.
# ---------------------------------------------------------------------------

# Live backend API origin (no trailing slash). Leave blank until a backend is wired.
VITE_BACKEND_URL=

# Canonical production origin for absolute links / SEO / redirects.
VITE_SITE_ORIGIN=https://zevixa.site

# API base URL for premium content.
VITE_API_BASE_URL=http://mhadevinfotech.in/api_webvideo/api_webvideos.php
